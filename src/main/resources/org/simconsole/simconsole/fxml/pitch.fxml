<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import org.simconsole.simconsole.DynamicSlider?>
<?import org.simconsole.simconsole.LedButton?>

<StackPane minHeight="0.0" minWidth="0.0" styleClass="controls-card" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <stylesheets>
      <URL value="@../css/card.css" />
      <URL value="@../css/slider.css" />
      <URL value="@../css/button.css" />
   </stylesheets>
   <children>
      <GridPane alignment="CENTER">
         <columnConstraints>
            <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="10.0" percentWidth="100.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints minHeight="0.0" percentHeight="80.0" valignment="CENTER" vgrow="SOMETIMES" />
            <RowConstraints minHeight="0.0" percentHeight="20.0" valignment="CENTER" vgrow="SOMETIMES" />
         </rowConstraints>
         <children>
            <DynamicSlider minHeight="0.0" minWidth="0.0" orientation="VERTICAL" />
            <LedButton minHeight="0.0" minWidth="0.0" roundShape="true" text="♪" textSizeRatio="0.5" toggleMode="true" GridPane.rowIndex="1" />
         </children>
      </GridPane>
   </children>
</StackPane>
