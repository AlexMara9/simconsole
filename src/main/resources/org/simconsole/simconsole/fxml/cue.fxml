<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>

<HBox fx:id="buttonsContainer" alignment="CENTER" minHeight="0.0" minWidth="0.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.simconsole.simconsole.CueController">
   <children>
      <Button fx:id="cue1" minHeight="0.0" minWidth="0.0" mnemonicParsing="false" text="1" HBox.hgrow="ALWAYS" />
      <Button fx:id="cue2" minHeight="0.0" minWidth="0.0" mnemonicParsing="false" text="2" HBox.hgrow="ALWAYS" />
      <Button fx:id="cue3" minHeight="0.0" minWidth="0.0" mnemonicParsing="false" text="3" HBox.hgrow="ALWAYS" />
      <Button fx:id="cue4" minHeight="0.0" minWidth="0.0" mnemonicParsing="false" text="4" HBox.hgrow="ALWAYS" />
   </children>
</HBox>
