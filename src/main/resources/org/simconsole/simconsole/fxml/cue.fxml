   <children>
      <DynamicSquareButton fx:id="cue1" minHeight="0.0" minWidth="0.0" text="1" textSizeRatio="0.4" />
      <DynamicSquareButton fx:id="cue2" minHeight="0.0" minWidth="0.0" text="2" textSizeRatio="0.4" />
      <DynamicSquareButton fx:id="cue3" minHeight="0.0" minWidth="0.0" text="3" textSizeRatio="0.4" />
      <DynamicSquareButton fx:id="cue4" minHeight="0.0" minWidth="0.0" text="4" textSizeRatio="0.4" />
   </children>
</HBox>
