<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import java.lang.String?>
<?import javafx.scene.layout.Region?>

<GridPane styleClass="card" minWidth="0.0" minHeight="0.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.simconsole.simconsole.PlaylistController">
    <columnConstraints>
        <ColumnConstraints percentWidth="42.0" />
        <ColumnConstraints percentWidth="58.0" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints vgrow="ALWAYS" />
    </rowConstraints>
    <children>
        <!-- Left Side: Search -->
        <VBox alignment="TOP_CENTER" spacing="5" style="-fx-padding: 0 5 0 0;" GridPane.columnIndex="0" minWidth="0.0">
            <children>
                <HBox alignment="CENTER" spacing="5" minWidth="0.0">
                    <StackPane minWidth="0.0">
                        <Button fx:id="searchButton" style="-fx-background-color: transparent; -fx-cursor: hand;">
                            <graphic>
                                <Region style="-fx-min-width: 1.2em; -fx-min-height: 1.2em; -fx-pref-width: 1.2em; -fx-pref-height: 1.2em; -fx-max-width: 1.2em; -fx-max-height: 1.2em;" mouseTransparent="true">
                                    <styleClass>
                                        <String fx:value="svg-icon" />
                                        <String fx:value="icon-search" />
                                    </styleClass>
                                </Region>
                            </graphic>
                        </Button>
                        <ProgressIndicator fx:id="searchProgress" visible="false" managed="false" prefWidth="16" prefHeight="16" />
                    </StackPane>
                    <StackPane HBox.hgrow="ALWAYS" minWidth="0.0">
                        <TextField fx:id="searchField" minWidth="0.0" promptText="search song" style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-border-color: #555555; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0.3em 1.5em 0.3em 0.6em; -fx-font-size: 1em;" />
                        <Button fx:id="clearSearchButton" text="✕" visible="false" StackPane.alignment="CENTER_RIGHT" style="-fx-background-color: transparent; -fx-text-fill: #aaaaaa; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 1em;" />
                    </StackPane>
                </HBox>
                <StackPane VBox.vgrow="ALWAYS">
                    <VBox fx:id="placeholderBox" alignment="CENTER" spacing="10">
                        <javafx.scene.image.ImageView fx:id="placeholderImage" preserveRatio="true" opacity="0.4">
                            <image>
                                <javafx.scene.image.Image url="@../img/search_placeholder_processed.png" />
                            </image>
                        </javafx.scene.image.ImageView>
                        <Label text="Search your music..." style="-fx-text-fill: #555555; -fx-font-size: 1em; -fx-font-weight: bold;" />
                    </VBox>
                    <ListView fx:id="searchList" style="-fx-background-color: transparent;" />
                </StackPane>
                <Button fx:id="localButton" text="LOCAL" maxWidth="Infinity" style="-fx-background-color: #222222; -fx-text-fill: white; -fx-font-family: 'Segoe UI', 'Inter', sans-serif; -fx-font-weight: bold; -fx-border-color: #555555; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0.6em 1em; -fx-cursor: hand; -fx-font-size: 1em; -fx-alignment: CENTER; -fx-graphic-text-gap: 0.5em;">
                    <graphic>
                        <Region style="-fx-min-width: 1.2em; -fx-min-height: 1.2em; -fx-pref-width: 1.2em; -fx-pref-height: 1.2em; -fx-max-width: 1.2em; -fx-max-height: 1.2em;" mouseTransparent="true">
                            <styleClass>
                                <String fx:value="svg-icon" />
                                <String fx:value="icon-folder" />
                            </styleClass>
                        </Region>
                    </graphic>
                </Button>
            </children>
        </VBox>
        
        <!-- Right Side: Playlist -->
        <VBox alignment="TOP_CENTER" style="-fx-padding: 0 0 0 5; -fx-border-color: #333333; -fx-border-width: 0 0 0 1px;" GridPane.columnIndex="1" minWidth="0.0" minHeight="0.0">
            <children>
                <TableView fx:id="playlistTable" VBox.vgrow="ALWAYS" minWidth="0.0" minHeight="0.0" maxWidth="Infinity">
                    <columns>
                        <TableColumn fx:id="colTitle" text="Title" prefWidth="200" minWidth="0" style="-fx-alignment: CENTER_LEFT;" />
                        <TableColumn fx:id="colDuration" text="Time" prefWidth="70" minWidth="0" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colState" text="State" prefWidth="80" minWidth="0" style="-fx-alignment: CENTER;" />
                        <TableColumn text="Deck">
                            <columns>
                                <TableColumn fx:id="colLeft" text="L" prefWidth="55" minWidth="0" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colRight" text="R" prefWidth="55" minWidth="0" style="-fx-alignment: CENTER;" />
                            </columns>
                        </TableColumn>
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</GridPane>
