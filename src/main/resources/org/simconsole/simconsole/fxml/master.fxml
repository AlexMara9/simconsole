<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import org.simconsole.simconsole.DynamicSlider?>


<StackPane minHeight="0.0" minWidth="0.0" styleClass="card" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <GridPane>
         <columnConstraints>
            <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="0.0" percentWidth="100.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints minHeight="0.0" percentHeight="70.0" valignment="CENTER" vgrow="SOMETIMES" />
            <RowConstraints minHeight="0.0" percentHeight="30.0" valignment="CENTER" vgrow="SOMETIMES" />
         </rowConstraints>
         <children>
            <DynamicSlider orientation="VERTICAL" />
            <DynamicSlider GridPane.rowIndex="1" />
         </children>
      </GridPane>
   </children>
   <stylesheets>
      <URL value="@../css/card.css" />
      <URL value="@../css/slider.css" />
   </stylesheets>
</StackPane>
